{
  "entities": {
    "User": {
      "title": "User Profile",
      "description": "Public and private user profile information",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "Unique user ID" },
        "email": { "type": "string", "format": "email", "description": "User email address" },
        "displayName": { "type": "string", "maxLength": 100 },
        "photoURL": { "type": "string", "format": "uri" },
        "role": { "type": "string", "enum": ["student", "professional", "employer", "admin"] },
        "bio": { "type": "string", "maxLength": 500 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "role"]
    },
    "Resource": {
      "title": "Resource",
      "description": "Educational resource, IT skill, job listing, or product/service",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string", "maxLength": 200 },
        "description": { "type": "string", "maxLength": 2000 },
        "category": { "type": "string", "enum": ["education", "it_skills", "jobs", "products", "solutions"] },
        "tags": { "type": "array", "items": { "type": "string" }, "maxLength": 10 },
        "location": { "type": "string", "description": "Region in Oman", "maxLength": 100 },
        "price": { "type": "number", "description": "Price in OMR if applicable" },
        "externalUrl": { "type": "string", "format": "uri" },
        "authorId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "description", "category", "authorId"]
    },
    "GeneratedImage": {
      "title": "Generated Image",
      "description": "Images generated via Gemini AI",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "prompt": { "type": "string", "maxLength": 1000 },
        "imageUrl": { "type": "string", "format": "uri" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "prompt", "imageUrl"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profiles"
    },
    "/resources/{resourceId}": {
      "schema": "Resource",
      "description": "Marketplace and education items"
    },
    "/generated_images/{imageId}": {
      "schema": "GeneratedImage",
      "description": "User generated AI images"
    }
  }
}
